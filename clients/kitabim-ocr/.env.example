KITABIM_BASE_URL=https://kitabim.ai/api
KITABIM_WORK_DIR=~/kitabim-ocr-work
SECURITY_APP_ID=your-security-app-id

# OCR Engine: "chandra" (default)
KITABIM_OCR_ENGINE=chandra

# Chandra backend inference method: "hf" (default, Hugging Face transformers/MPS/CUDA) or "vllm"
KITABIM_CHANDRA_METHOD=hf

# Chandra model checkpoint (default: datalab-to/chandra-ocr-2)
KITABIM_CHANDRA_MODEL_CHECKPOINT=datalab-to/chandra-ocr-2

# Chandra prompt mode: "ocr_layout" (default, layout blocks & tables) or "ocr" (pure text paragraphs)
KITABIM_CHANDRA_PROMPT_TYPE=ocr_layout

# Chandra script/language guidance injected into prompt (set to "none" or empty to disable)
KITABIM_CHANDRA_PROMPT_GUIDANCE=Input book pages are in Uyghur. All text must be accurately transcribed in modern Uyghur using Uyghur Arabic script verbatim, preserving diacritical marks and punctuation without translating or omitting text.

# Repetition penalty for Chandra HF generation (default: 1.05, range: 1.0-2.0)
KITABIM_CHANDRA_REPETITION_PENALTY=1.05

# Concurrency: Number of pages to process concurrently (default: 1, max: 4)
KITABIM_OCR_CONCURRENCY=1

# Timeout per page in seconds (default: 300, set to 0 or none to disable)
KITABIM_OCR_PAGE_TIMEOUT=300

# Max retries per page on recoverable errors (default: 2, min: 1)
KITABIM_OCR_MAX_RETRIES=2

# PyTorch device: "mps" (auto-detected on Apple Silicon), "cuda", or "cpu"
TORCH_DEVICE=mps

# Optional Hugging Face token to avoid unauthenticated rate limits / warnings
# HF_TOKEN=hf_...

KITABIM_BASE_URL=https://kitabim.ai/api
KITABIM_WORK_DIR=~/kitabim-ocr-work
SECURITY_APP_ID=your-security-app-id

# OCR Engine: "surya" (default, PyTorch/MPS/CPU) or "savitr" (Apple Silicon MLX-optimized)
KITABIM_OCR_ENGINE=surya

# Concurrency: Number of pages to process concurrently (default: 4, max: 8 for Surya; 6 leaves 2 spare slots for crop fallbacks)
KITABIM_OCR_CONCURRENCY=6
KITABIM_OCR_WAVE_BATCHING=true

# Timeout per page in seconds (default: 120, set to 0 or none to disable)
KITABIM_OCR_PAGE_TIMEOUT=1200

# Max retries per page on recoverable errors (default: 2, min: 1)
KITABIM_OCR_MAX_RETRIES=2

# Sane max token generation ceiling for Surya full-page OCR (default: 2500)
SURYA_MAX_TOKENS_FULL_PAGE=2500

# Lossless Surya 2.5 / llama-server throughput tuning (Apple Silicon Metal)
SURYA_INFERENCE_LOGPROBS=false
SURYA_INFERENCE_PARALLEL=8
SURYA_INFERENCE_CTX_PER_SLOT=6144
LLAMA_CPP_EXTRA_ARGS="-fa on -b 4096 -ub 2048 --cache-ram 0 --no-cache-prompt -lv 1"

# Optional fine-tuned local Surya 2.5 GGUF f16 weights (llama.cpp)
# SURYA_INFERENCE_BACKEND=llamacpp
# SURYA_GGUF_LOCAL_MODEL_PATH=/Users/omarjan/.cache/datalab/models/surya-2.5-uyghur-v2-gguf/surya-2.5-uyghur-v2.gguf
# SURYA_GGUF_LOCAL_MMPROJ_PATH=/Users/omarjan/.cache/datalab/models/surya-2.5-uyghur-v2-gguf/surya-2.5-uyghur-v2-mmproj.gguf

# Optional custom path to converted MLX model for Savitr
# SAVITR_MODEL_PATH=models/surya-mlx-4bit

# Optional Hugging Face token to avoid unauthenticated rate limits / warnings
# HF_TOKEN=hf_...


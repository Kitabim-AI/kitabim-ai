KITABIM_BASE_URL=https://kitabim.ai/api
KITABIM_WORK_DIR=~/kitabim-ocr-work
KITABIM_APP_ID=your-security-app-id

# OCR Engine: "surya" (default, PyTorch/MPS/CPU) or "savitr" (Apple Silicon MLX-optimized)
KITABIM_OCR_ENGINE=surya

# Concurrency: Number of pages to process concurrently (default: 4, max: 4 for Surya)
KITABIM_OCR_CONCURRENCY=4

# Timeout per page in seconds (default: 120, set to 0 or none to disable)
KITABIM_OCR_PAGE_TIMEOUT=1200

# Max retries per page on recoverable errors (default: 2, min: 1)
KITABIM_OCR_MAX_RETRIES=2

# Sane max token generation ceiling for Surya full-page OCR (default: 2500)
SURYA_MAX_TOKENS_FULL_PAGE=2500

# Optional custom path to converted MLX model for Savitr
# SAVITR_MODEL_PATH=models/surya-mlx-4bit

# Optional Hugging Face token to avoid unauthenticated rate limits / warnings
# HF_TOKEN=hf_...


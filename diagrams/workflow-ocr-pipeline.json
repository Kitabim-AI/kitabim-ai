    { "id": "splitter-to-ocr", "from": "page_splitter", "to": "gemini_ocr", "variant": "emphasis" },
    { "id": "ocr-to-embed", "from": "gemini_ocr", "to": "vector_embedder", "variant": "emphasis" },
    { "id": "embed-to-db", "from": "vector_embedder", "to": "db_commit", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Page Processing & OCR",
      "items": [
        "PDF files are split into high-resolution PNG page images",
        "Google Gemini Vision API executes page-by-page OCR for Uyghur script"
      ]
    },
    {
      "dot": "emerald",
      "title": "Text Normalization & Embeddings",
      "items": [
        "Raw OCR text passes through Uyghur spellcheck filter & auto-correct rules",
        "Cleaned text is chunked into 500-token windows with 50-token overlap",
        "Google Gemini API generates 768-dimensional embeddings saved to pgvector"
      ]
    }
  ]

  "phases": [
    { "id": "intake_phase", "label": "Upload Intake", "fromCol": 0, "toCol": 2 },
    { "id": "ocr_phase", "label": "OCR Processing", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "persist_phase", "label": "Vector Index", "fromCol": 5, "toCol": 5, "variant": "dashed" }

    { "id": "user", "lane": "ui_intake", "col": 0, "type": "external", "label": "User Upload", "sublabel": "selects PDF" },
    { "id": "upload_api", "lane": "api_gateway", "col": 1, "type": "backend", "label": "FastAPI", "sublabel": "file intake" },
    { "id": "redis_broker", "lane": "queue_broker", "col": 2, "type": "database", "label": "Redis Queue", "sublabel": "ARQ job" },
    { "id": "page_splitter", "lane": "splitter_lane", "col": 3, "type": "backend", "label": "Page Splitter", "sublabel": "render PNGs" },
    { "id": "gemini_ocr", "lane": "ocr_lane", "col": 4, "type": "backend", "label": "Gemini OCR", "sublabel": "Vision API" },
    { "id": "vector_embedder", "lane": "embed_lane", "col": 5, "type": "cloud", "label": "Gemini Vector", "sublabel": "embeddings" },
    { "id": "db_commit", "lane": "storage_lane", "col": 5, "type": "database", "label": "PGVector", "sublabel": "save chunks" }
  ],
  "edges": [
    { "id": "user-to-api", "from": "user", "to": "upload_api", "variant": "emphasis" },
    { "id": "api-to-redis", "from": "upload_api", "to": "redis_broker", "variant": "dashed" },
